\documentclass[10pt,a4paper]{ctexart}
{% include "_partials/common_macros.tex.j2" %}
\geometry{left=1.2cm,right=1.2cm,top=1.15cm,bottom=1.15cm}
\definecolor{accent}{HTML}{7C3AED}
\definecolor{sidebg}{HTML}{F5F3FF}
\definecolor{ink}{HTML}{1F2937}
\definecolor{muted}{HTML}{6B7280}
\renewcommand{\rgSection}[1]{\vspace{0.55em}{\large\bfseries\color{accent}#1}\par\vspace{0.18em}{\color{accent}\rule{\linewidth}{0.8pt}}\vspace{0.28em}}

\begin{document}
\setlength{\fboxsep}{0.7em}
\noindent\colorbox{sidebg}{\parbox{0.965\linewidth}{
\begin{tabularx}{\linewidth}{@{}p{2.65cm} X@{}}
\centering
{% if basic.hasPhoto %}
\includegraphics[width=2.35cm,height=2.85cm,keepaspectratio]{ {{- basic.photoPath -}} }
{% else %}
\rgPhotoPlaceholder{accent}{white}{ {{ basic.name }} }
{% endif %}
&
\raggedright
{\Huge\bfseries\color{ink}{{ basic.name }}}\par
{% if basic.title %}\vspace{0.2em}{\Large\color{accent}{{ basic.title }}}\par{% endif %}
\vspace{0.45em}{\small\color{muted}{% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.8em}|\hspace{0.8em}{% endif %}{{ contact.label }}：{{ contact.value }}{% endfor %}}\par
{% if skills %}\vspace{0.55em}{\bfseries\color{accent}技能}\quad {% for skill in skills %}\fcolorbox{accent}{white}{\scriptsize {{ skill }}}\hspace{0.25em}{% endfor %}{% endif %}
\\
\end{tabularx}
}}
\vspace{0.35em}

{% if basic.summary %}
\rgSection{个人概要}
{\small\justifying {{ basic.summary }}}\par
{% endif %}
{% if education %}
\rgSection{教育背景}
{% for e in education %}
\rgEntry{ {{ e.school }} }{ {{ e.date }} }{ {{ e.degree }}{% if e.degree and e.major %}\hspace{0.5em}|\hspace{0.5em}{% endif %}{{ e.major }} }{}
{% if e.bullets %}\begin{rgBullets}
{% for bullet in e.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}
{% endfor %}{% endif %}
{% if experience %}
\rgSection{工作经历}
{% for e in experience %}
\rgEntry{ {{ e.company }} }{ {{ e.date }} }{ \textcolor{accent}{ {{ e.role }} } }{}
{% if e.bullets %}\begin{rgBullets}
{% for bullet in e.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}
{% endfor %}{% endif %}
{% if projects %}
\rgSection{项目经历}
{% for p in projects %}
\rgEntry{ {{ p.name }} }{ {{ p.date }} }{ {{ p.role }} }{}
{% if p.bullets %}\begin{rgBullets}
{% for bullet in p.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}
{% endfor %}{% endif %}
{% if research %}
\rgSection{科研经历}
{% for r in research %}
\rgEntry{ {{ r.name }} }{ {{ r.date }} }{ {{ r.role }} }{}
{% if r.bullets %}\begin{rgBullets}
{% for bullet in r.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}
{% endfor %}{% endif %}
{% if studentWork %}
\rgSection{学生工作}
{% for s in studentWork %}
\rgEntry{ {{ s.organization }} }{ {{ s.date }} }{ {{ s.role }} }{}
{% if s.bullets %}\begin{rgBullets}
{% for bullet in s.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}
{% endfor %}{% endif %}
{% if honors %}
\rgSection{荣誉奖项}
\begin{rgBullets}
{% for item in honors %}\item {{ item }}
{% endfor %}\end{rgBullets}
{% endif %}
\end{document}
