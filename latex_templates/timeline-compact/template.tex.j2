\documentclass[9.5pt,a4paper]{ctexart}
{% include "_partials/common_macros.tex.j2" %}
\geometry{left=1.25cm,right=1.25cm,top=1.1cm,bottom=1.1cm}
\definecolor{accent}{HTML}{ {{ visual.accent }} }
\definecolor{line}{HTML}{FDBA74}
\definecolor{ink}{HTML}{111827}
\renewcommand{\rgSection}[1]{\vspace{ {{ '%.2f'|format(0.42 * visual.spacingScale) }}em}{\large\bfseries\color{accent}#1}\par\vspace{0.12em}{\color{line}\rule{\linewidth}{0.7pt}}\vspace{ {{ '%.2f'|format(0.25 * visual.spacingScale) }}em}}

\begin{document}
{% set photo_w = '%.2fcm'|format(1.65 * visual.photoScale) %}
{% set photo_h = '%.2fcm'|format(1.95 * visual.photoScale) %}
{% set show_photo = basic.hasPhoto and visual.showPhoto and visual.photoPosition != 'none' %}
{% if show_photo and visual.photoPosition == 'left' %}
\begin{tabularx}{\linewidth}{@{}p{ {{ '%.2fcm'|format(2.05 * visual.photoScale) }} } X@{}}
\rgPhotoFrame{accent}{ {{- basic.photoPath -}} }{ {{ photo_w }} }{ {{ photo_h }} }{0.7pt} & {\Huge\bfseries\color{ink}{{ basic.name }}}{% if basic.title %}\hspace{0.8em}{\Large\color{accent}{{ basic.title }}}{% endif %}\par\vspace{0.16em}{\small {% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.7em}|\hspace{0.7em}{% endif %}{{ contact.value }}{% endfor %}} \\
\end{tabularx}
{% elif show_photo and visual.photoPosition == 'right' %}
\begin{tabularx}{\linewidth}{@{}X p{ {{ '%.2fcm'|format(2.05 * visual.photoScale) }} }@{}}
{\Huge\bfseries\color{ink}{{ basic.name }}}{% if basic.title %}\hspace{0.8em}{\Large\color{accent}{{ basic.title }}}{% endif %}\par\vspace{0.16em}{\small {% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.7em}|\hspace{0.7em}{% endif %}{{ contact.value }}{% endfor %}} & \raggedleft\rgPhotoFrame{accent}{ {{- basic.photoPath -}} }{ {{ photo_w }} }{ {{ photo_h }} }{0.7pt} \\
\end{tabularx}
{% elif show_photo and visual.photoPosition == 'top' %}
\begin{center}\rgPhotoFrame{accent}{ {{- basic.photoPath -}} }{ {{ photo_w }} }{ {{ photo_h }} }{0.7pt}\par\vspace{0.25em}{\Huge\bfseries\color{ink}{{ basic.name }}}{% if basic.title %}\hspace{0.8em}{\Large\color{accent}{{ basic.title }}}{% endif %}\par{\small {% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.7em}|\hspace{0.7em}{% endif %}{{ contact.value }}{% endfor %}}\end{center}
{% else %}
{\Huge\bfseries\color{ink}{{ basic.name }}}{% if basic.title %}\hspace{0.8em}{\Large\color{accent}{{ basic.title }}}{% endif %}\par\vspace{0.16em}{\small {% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.7em}|\hspace{0.7em}{% endif %}{{ contact.value }}{% endfor %}}\par
{% endif %}
{% if basic.summary %}\vspace{0.25em}{\small\justifying {{ basic.summary }}}\par{% endif %}

{% if education %}\rgSection{教育}{% for e in education %}\rgSimpleEntry{ {{ e.school }} · {{ e.degree }} {{ e.major }} }{ {{ e.date }} }
{% if e.bullets %}\begin{rgBullets}{% for bullet in e.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if experience %}\rgSection{经历}{% for e in experience %}\rgSimpleEntry{ {{ e.company }} · {{ e.role }} }{ {{ e.date }} }
{% if e.bullets %}\begin{rgBullets}{% for bullet in e.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if research %}\rgSection{科研}{% for r in research %}\rgSimpleEntry{ {{ r.name }} · {{ r.role }} }{ {{ r.date }} }
{% if r.bullets %}\begin{rgBullets}{% for bullet in r.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if projects %}\rgSection{项目}{% for p in projects %}\rgSimpleEntry{ {{ p.name }} · {{ p.role }} }{ {{ p.date }} }
{% if p.bullets %}\begin{rgBullets}{% for bullet in p.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if studentWork %}\rgSection{组织}{% for s in studentWork %}\rgSimpleEntry{ {{ s.organization }} · {{ s.role }} }{ {{ s.date }} }
{% if s.bullets %}\begin{rgBullets}{% for bullet in s.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if skills or honors %}\rgSection{补充}{% if skills %}{\small\bfseries 技能：}{\small {% for skill in skills %}{{ skill }}{% if not loop.last %}；{% endif %}{% endfor %}}\par{% endif %}
{% if honors %}{\small\bfseries 荣誉：}{\small {% for item in honors %}{{ item }}{% if not loop.last %}；{% endif %}{% endfor %}}\par{% endif %}{% endif %}
\end{document}
