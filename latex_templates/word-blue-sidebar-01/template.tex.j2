{% if skills %}\blueSideTitle{专业技能}\raggedright{% for skill in skills %}\blueSideText{\textbullet\hspace{0.35em}{{ skill }} }{% endfor %}{% endif %}
{% if honors %}\blueSideTitle{荣誉奖励}\raggedright{% for item in honors[:5] %}\blueSideText{\textbullet\hspace{0.35em}{{ item }} }{% endfor %}{% endif %}
}}}}
\vspace*{-0.10em}
{\Huge\bfseries\color{rule}{{ basic.name }}}\par{}
{% if basic.title %}{\small\color{muted}求职意向：{{ basic.title }}}\par{}{% endif %}
