\renewcommand{\rgSection}[1]{\vspace{ {{ '%.2f'|format(0.42 * visual.spacingScale) }}em}{\large\bfseries\color{rule}#1}\par\vspace{0.10em}{\color{rule}\rule{\linewidth}{0.90pt}}\vspace{ {{ '%.2f'|format(0.20 * visual.spacingScale) }}em}}
{% raw %}
\renewcommand{\rgEntry}[4]{%
  \begin{tabularx}{\linewidth}{@{}X r@{}}
    {\bfseries\color{rule}#1} & {\scriptsize\color{muted}#2} \\
    {\small #3} & {\scriptsize\color{muted}#4} \\
  \end{tabularx}\par\vspace{-0.45em}%
}
\newcommand{\blueSideTitle}[1]{\vspace{0.70em}{\bfseries\color{white}#1}\par\vspace{0.20em}{\color{sidebarSoft}\rule{0.76\linewidth}{0.55pt}}\par\vspace{0.22em}}
\newcommand{\blueSideText}[1]{{\scriptsize\color{white}#1}\par\vspace{0.18em}}
{% endraw %}

\begin{document}
{% set show_photo = basic.hasPhoto and visual.showPhoto and visual.photoPosition != 'none' %}
{% set photo_w = '%.2fcm'|format(2.35 * visual.photoScale) %}
{% set photo_h = '%.2fcm'|format(2.85 * visual.photoScale) %}
{% set sidebar_items = basic.contacts %}
