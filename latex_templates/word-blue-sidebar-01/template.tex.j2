\rgPhotoFrame{white}{ {{- basic.photoPath -}} }{ {{ photo_w }} }{ {{ photo_h }} }{0.6pt}\par\vspace{0.48em}
{% else %}
\rgPhotoPlaceholder{white}{sidebar}{ {{ basic.name }} }\par\vspace{0.48em}
{% endif %}
{\scriptsize\color{sidebarSoft}{% if basic.title %}{{ basic.title }}{% else %}简历信息{% endif %}}\par\vspace{0.30em}
{% for contact in sidebar_items %}\blueSideText{\raggedright {{ contact.value }} }{% endfor %}
{% if education %}\blueSideText{ {{ education[0].school }} · {{ education[0].major }} }{% endif %}
