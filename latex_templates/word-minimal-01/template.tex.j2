\definecolor{accent}{HTML}{ {{ visual.accent }} }
\definecolor{ink}{HTML}{111827}
\definecolor{muted}{HTML}{4B5563}
\definecolor{soft}{HTML}{F8FAFC}
\definecolor{line}{HTML}{E5E7EB}
\renewcommand{\rgSection}[1]{\vspace{ {{ '%.2f'|format(0.58 * visual.spacingScale) }}em}{\large\bfseries\color{ink}#1}\hspace{0.45em}{\color{accent}\rule[0.55ex]{0.20\linewidth}{1pt}}\par\vspace{ {{ '%.2f'|format(0.28 * visual.spacingScale) }}em}}

\begin{document}
{% set photo_w = '%.2fcm'|format(2.05 * visual.photoScale) %}
{% set photo_h = '%.2fcm'|format(2.45 * visual.photoScale) %}
{% set show_photo = basic.hasPhoto and visual.showPhoto and visual.photoPosition != 'none' %}
\setlength{\fboxsep}{0.65em}
\noindent\colorbox{soft}{\parbox{0.965\linewidth}{
{% if show_photo and visual.photoPosition == 'left' %}
\begin{tabularx}{\linewidth}{@{}p{ {{ '%.2fcm'|format(2.55 * visual.photoScale) }} } X@{}}
\rgPhotoFrame{accent}{ {{- basic.photoPath -}} }{ {{ photo_w }} }{ {{ photo_h }} }{0.55pt} & {\Huge\bfseries\color{ink}{{ basic.name }}}\par{}{% if basic.title %}{\Large\color{accent}{{ basic.title }}}\par{}{% endif %}\vspace{0.28em}{\small\color{muted}{% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.75em}|\hspace{0.75em}{% endif %}{{ contact.value }}{% endfor %}} \\
\end{tabularx}
{% elif show_photo and visual.photoPosition == 'top' %}
\begin{center}\rgPhotoFrame{accent}{ {{- basic.photoPath -}} }{ {{ photo_w }} }{ {{ photo_h }} }{0.55pt}\par{}\vspace{0.28em}{\Huge\bfseries\color{ink}{{ basic.name }}}\par{}{% if basic.title %}{\Large\color{accent}{{ basic.title }}}\par{}{% endif %}{\small\color{muted}{% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.75em}|\hspace{0.75em}{% endif %}{{ contact.value }}{% endfor %}}\end{center}
{% else %}
\begin{tabularx}{\linewidth}{@{}X p{ {{ '%.2fcm'|format(2.55 * visual.photoScale) }} }@{}}
{\Huge\bfseries\color{ink}{{ basic.name }}}\par{}{% if basic.title %}{\Large\color{accent}{{ basic.title }}}\par{}{% endif %}\vspace{0.28em}{\small\color{muted}{% for contact in basic.contacts %}{% if not loop.first %}\hspace{0.75em}|\hspace{0.75em}{% endif %}{{ contact.value }}{% endfor %}} & {% if show_photo %}\raggedleft\rgPhotoFrame{accent}{ {{- basic.photoPath -}} }{ {{ photo_w }} }{ {{ photo_h }} }{0.55pt}{% endif %} \\
\end{tabularx}
{% endif %}
{% if basic.summary %}\vspace{0.36em}{\small\justifying\color{muted}{{ basic.summary }}}\par{}{% endif %}
}}
\vspace{0.35em}

{% if education %}\rgSection{教育背景}{% for e in education %}\rgEntry{ {{ e.school }} }{ {{ e.date }} }{ {{ e.degree }}{% if e.degree and e.major %}\hspace{0.5em}|\hspace{0.5em}{% endif %}{{ e.major }} }{}
{% if e.bullets %}\begin{rgBullets}{% for bullet in e.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if experience %}\rgSection{工作经历}{% for e in experience %}\rgEntry{ {{ e.company }} }{ {{ e.date }} }{ {{ e.role }} }{}
{% if e.bullets %}\begin{rgBullets}{% for bullet in e.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if projects %}\rgSection{项目经历}{% for p in projects %}\rgEntry{ {{ p.name }} }{ {{ p.date }} }{ {{ p.role }} }{}
{% if p.bullets %}\begin{rgBullets}{% for bullet in p.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
{% if research %}\rgSection{科研经历}{% for r in research %}\rgEntry{ {{ r.name }} }{ {{ r.date }} }{ {{ r.role }} }{}
{% if r.bullets %}\begin{rgBullets}{% for bullet in r.bullets %}\item {{ bullet }}
{% endfor %}\end{rgBullets}{% endif %}{% endfor %}{% endif %}
