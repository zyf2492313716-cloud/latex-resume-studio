{
  "name": "latex-resume-studio",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "install-python-deps": "bash scripts/install-python-deps.sh",
    "dist": "bash scripts/install-python-deps.sh && vite build && PATH=\"scripts/py-wrapper:node_modules/.bin:/opt/homebrew/bin:/usr/bin:/bin\" electron-builder --mac --publish=never"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "docx-preview": "^0.3.7",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.zyf.latex-resume-studio",
    "productName": "LaTeX 简历工坊",
    "directories": {
      "output": "dist-desktop"
    },
    "mac": {
      "identity": null,
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "publish": {
        "provider": "github",
        "owner": "zyf2492313716-cloud",
        "repo": "latex-resume-studio",
        "releaseType": "release"
      }
    },
    "dmg": {
      "iconSize": 120,
      "iconTextSize": 14,
      "title": "LaTeX 简历工坊安装盘",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 480,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 440
      }
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/utils",
        "to": "utils"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "latex_templates",
        "to": "latex_templates"
      }
    ],
    "asar": false
  }
}
