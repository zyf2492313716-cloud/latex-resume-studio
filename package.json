{
  "name": "latex-resume-studio",
  "private": true,
  "version": "3.0.0",
  "description": "LaTeX 简历工坊：专注 LaTeX 模板、可视调版与 PDF/.tex 导出的跨平台简历生成器",
  "author": "zhouyufeng",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "install-python-deps": "node scripts/install-python-deps.cjs",
    "dist": "node scripts/install-python-deps.cjs && vite build && PATH=\"scripts/py-wrapper:node_modules/.bin:/opt/homebrew/bin:/usr/bin:/bin\" electron-builder --mac --publish=never",
    "dist:win": "node scripts/install-python-deps.cjs && vite build && electron-builder --win zip --x64 --publish=never",
    "android:sync": "vite build && cap sync android",
    "android:debug": "vite build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.3",
    "electron-builder": "^26.15.0",
    "vite": "^8.0.16"
  },
  "dependencies": {
    "@capacitor/android": "^8.4.0",
    "@capacitor/core": "^8.4.0",
    "canvas-confetti": "^1.9.4",
    "docx-preview": "^0.3.7",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "build": {
    "appId": "com.zyf.latex-resume-studio",
    "productName": "LaTeX 简历工坊",
    "directories": {
      "output": "dist-desktop"
    },
    "mac": {
      "identity": null,
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities",
      "icon": "build/icon.icns",
      "publish": {
        "provider": "github",
        "owner": "zyf2492313716-cloud",
        "repo": "latex-resume-studio",
        "releaseType": "release"
      }
    },
    "dmg": {
      "iconSize": 120,
      "iconTextSize": 14,
      "title": "LaTeX 简历工坊安装盘",
      "contents": [
        {
          "x": 140,
          "y": 200,
          "type": "file"
        },
        {
          "x": 480,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 660,
        "height": 440
      }
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "preload.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/utils",
        "to": "utils"
      },
      {
        "from": "latex_templates",
        "to": "latex_templates"
      }
    ],
    "asar": true
  }
}
